{
  "ConnectionStrings": {
    "CampanhaDb": "Host=localhost;Port=5432;Database=campanha_db;Username=postgres;Password=postgres",
    "DoacoesMongo": "mongodb://localhost:27017"
  },
  "TransparenciaMongo": {
    "DatabaseName": "doacoes_db",
    "PainelMacroCollection": "painel_macro",
    "ListaCampanhasCollection": "lista_campanhas",
    "CampanhaDetalheCollection": "campanha_detalhe"
  },
  "Jwt": {
    "SecretKey": "SuperSecretKey-ParaDesenvolvimento-MinimoDE32Chars!",
    "Issuer": "esperanca-identity-api",
    "Audience": "esperanca-platform",
    "AccessTokenExpirationMinutes": 30
  },
  "Scheduler": {
    "IntervaloEmSegundos": 60,
    "ProximidadeVencimentoEmDias": 3
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "esperanca.doacoes",
    "DeadLetterExchange": "esperanca.doacoes.dlx",
    "RecebidaQueue": "doacoes-recebidas",
    "RecebidaRoutingKey": "recebida",
    "RecebidaDeadLetterQueue": "doacoes-recebidas-dlq",
    "ProcessadaQueue": "doacoes-processadas",
    "ProcessadaRoutingKey": "processada",
    "ProcessadaDeadLetterQueue": "doacoes-processadas-dlq",
    "PrefetchCount": 1
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
